# Porta do servidor (padrão: 8080)
PORT=8080

# Caminho do banco SQLite (padrão: ./data/hphisto.db)
DB_PATH=./data/hphisto.db

# Token de autenticação da API.
# Se vazio, a API fica aberta (útil em desenvolvimento local).
# Se definido, clientes externos precisam de: Authorization: Bearer <token>
# Também permite criar usuários adicionais via /api/auth/signup após o primeiro cadastro.
# Gere um token seguro com: openssl rand -hex 32
API_TOKEN=

# Ambiente de execução. Em produção, ativa cookies Secure e outras proteções.
NODE_ENV=production

# Force cookies Secure mesmo fora de NODE_ENV=production (ex: HTTPS local).
# true | false (padrão: false em dev, true em produção via docker-compose)
COOKIE_SECURE=false

# Origem permitida para CORS da API.
# Use '*' para liberar tudo (desenvolvimento) ou o domínio exato em produção.
# Ex: https://meusite.com
CORS_ORIGIN=*

# Imagem Docker a usar (padrão: GHCR). Troque pelo seu usuário/repo do GitHub.
HFSTO_IMAGE=ghcr.io/SEU-USUARIO/hphisto:latest
